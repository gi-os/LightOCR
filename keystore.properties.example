# Copy to keystore.properties (gitignored) for a local build that can replace a release
# install in place. Never commit the real file -- only the passwords are secret; the
# keystore itself (keystore/lightocr.jks) is committed, same as every sibling Light* repo.
storeFile=../keystore/lightocr.jks
storePassword=CHANGE_ME
keyAlias=lightocr
keyPassword=CHANGE_ME
